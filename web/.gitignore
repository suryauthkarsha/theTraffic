# dependencies
node_modules

# build
dist
dist-ssr

# env — every variant Vite's loadEnv reads (.env, .env.production, .env.development.local, …); only the
# root .env.example template is committed
.env
.env.*
!.env.example
*.local

# Native (core dumps at the app root only — never source folders named core/)
ios/
android/
/core
/core.[0-9]*

# Expo
.expo

# Vercel CLI project link (`vercel link` writes project and org ids here; the deployment is configured
# by vercel.json, which IS committed)
.vercel

# debug
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# IDE
.vscode/*
!.vscode/extensions.json
.idea

# macOS
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
